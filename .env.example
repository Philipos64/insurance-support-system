# Copy this to .env and fill in your key:
#     cp .env.example .env
#
# .env is git-ignored. Don't commit it.

# --- OpenAI ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# --- OpenRouter (optional) ---
# Only needed to run the Jev planner, with PLANNER=jev. The default
# planner is the JSON one and needs nothing but the OpenAI key above.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# --- PostgreSQL ---
# These are not secrets. They're the settings for the local Docker
# container, and they have to match docker-compose.yml or the app can't
# connect. The container is bound to 127.0.0.1, so it's only reachable
# from this machine, and everything in it is generated data.
#
# If you ever run this somewhere other than your own laptop, change the
# password in both files and keep the new one out of git.
DB_HOST=localhost
DB_NAME=testdb_new_v1
DB_USER=root
DB_PASSWORD=ABC
DB_PORT=5433
