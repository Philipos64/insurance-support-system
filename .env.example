# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# .env is git-ignored and must never be committed.

# --- OpenAI ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# --- PostgreSQL ---
# These defaults match docker-compose.yml. Change the password
# in BOTH files if you want something other than the demo value.
DB_HOST=localhost
DB_NAME=testdb_new_v1
DB_USER=root
DB_PASSWORD=ABC
DB_PORT=5433
